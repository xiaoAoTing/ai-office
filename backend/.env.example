DATABASE_URL=postgresql+asyncpg://ai_office:change-me@localhost:5433/ai_office
CORS_ORIGINS=["http://localhost:3000"]
# only these Host headers are answered (a DNS-rebinding page gets 400)
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# /docs and /redoc load Swagger UI / ReDoc from a CDN into the API origin; off unless needed
API_DOCS=false
TEST_DATABASE_URL=postgresql+asyncpg://ai_office:change-me@localhost:5433/ai_office_test

# Background task executor (fake work until stage 6); durations in seconds
EXECUTOR_ENABLED=true
# Trips from the map edge to the desk and back; the scene animation fits into these exactly
EXECUTOR_ARRIVE_SECONDS=75
EXECUTOR_STAGE_SECONDS=5
EXECUTOR_DEPART_SECONDS=75
# A departing car stays in its spot this long: a task before it turns the agent back to the desk, a later one
# lets the car drive to the map edge and come straight back. A return lasts the time spent leaving + the extra.
EXECUTOR_TURN_BACK_SECONDS=50
EXECUTOR_RETURN_EXTRA_SECONDS=12
# «Отпустить всех» lets people go this far apart (the exit barrier passes one car at a time)
EXECUTOR_RELEASE_GAP_SECONDS=5
EXECUTOR_TICK_SECONDS=1
EXECUTOR_PROGRESS_SECONDS=1
# fake = placeholder text; llm = local model via Ollama; qoder = the Qoder CLI runs each stage
EXECUTOR_WORKER=fake

# A heartbeat from outside (POST /api/v1/agents/{id}/live, see scripts/qoder-office-live.sh) counts as work
# this long; after that the agent puts its tools down and rests in the lounge.
# LIVE_TTL_SECONDS=180

# Qoder CLI (EXECUTOR_WORKER=qoder): one non-interactive `qoder -p` run per stage, no local model and no GPU needed.
# The run is isolated: no MCP servers, no built-in tools, no user/project settings, no session persistence,
# and its working directory is an empty temp directory (never this project).
# QODER_BIN=qoder
# Empty = the CLI's own default model; an agent's `model` field overrides it per agent.
# QODER_MODEL=
# QODER_NUM_CTX=16384
# QODER_RESERVE_TOKENS=6144
# Stages sent to the CLI at the same time
# QODER_CONCURRENCY=1
# A stage counts as stuck after this long without a new event line, and is cut off at this total limit.
# The CLI reports one line per completed message (not per token), so the idle limit must cover a whole answer.
# QODER_IDLE_TIMEOUT_SECONDS=900
# QODER_TIMEOUT_SECONDS=1800

# Ollama (EXECUTOR_WORKER=llm); an agent's `model` field overrides OLLAMA_MODEL
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=true
OLLAMA_TEMPERATURE=0.3
# requests sent to the model at the same time (GPU queue), stage timeout counted from sending, retries after a failure
LLM_CONCURRENCY=1
# a model call counts as stuck after this many seconds without a new chunk; Ollama out of reach is waited for
LLM_IDLE_TIMEOUT_SECONDS=120
LLM_RETRIES=1
# part of the context window kept free for the answer: at least LLM_RESERVE_TOKENS, and room for thinking
# (LLM_THINK_TOKENS, when OLLAMA_THINK=true) plus the expected answer (self-check: the size of the draft it rewrites)
LLM_RESERVE_TOKENS=6144
LLM_THINK_TOKENS=6144
# Research stage with web tools (agents with web access only); SearXNG runs in docker-compose
LLM_RESEARCH_TIMEOUT_SECONDS=900
SEARXNG_URL=http://127.0.0.1:8888
WEB_MAX_TOOL_CALLS=8
WEB_MAX_PAGES=4
WEB_PAGE_CHARS=4000
WEB_MAX_BYTES=2000000
WEB_TOOL_TIMEOUT_SECONDS=15
WEB_SEARCH_RESULTS=8

# Job search tools (agents with the "jobs" tool): Adzuna (https://developer.adzuna.com) and Reed
# (https://www.reed.co.uk/developers/jobseeker). Secrets: never commit them. A source without keys is skipped.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
# search_jobs + get_job calls per task (all versions), cache of identical searches (s), API timeout (s)
JOBS_MAX_CALLS=10
JOBS_CACHE_SECONDS=600
# a failed job API request is not repeated for this long
JOBS_FAILURE_CACHE_SECONDS=120
# requests per UTC day this app may send to each job API (the keys may be shared with other projects)
ADZUNA_DAILY_LIMIT=100
REED_DAILY_LIMIT=100
JOBS_TIMEOUT_SECONDS=15
JOBS_MAX_RESULTS=50
